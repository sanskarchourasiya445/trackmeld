# TrackMeld Environment Configuration Example
# Copy this file to .env and adjust variables as required.
# DO NOT commit .env or secrets to source control.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trackmeld
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/trackmeld
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Kolkata
