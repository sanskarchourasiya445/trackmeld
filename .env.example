# ==============================================================================
# TrackMeld - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# DO NOT commit .env or secrets to source control.
# ==============================================================================

# Database Configuration (PostgreSQL 18+)
# Async engine URL (used by FastAPI async sessions)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/trackmeld

# Sync engine URL (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5433/trackmeld

# Application Runtime Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=Asia/Kolkata

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background Worker & CP-SAT Engine Configuration
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_STALE_TIMEOUT_SECONDS=30.0
WORKER_MAX_ATTEMPTS=3
PLANNING_JOB_TIMEOUT_SECONDS=120.0

# Authentication & RBAC Tokens (Four-Eyes Governance)
# Provide secure, unique tokens for each role in production.
AUTH_ADMIN_TOKEN=demo-admin-token
AUTH_APPROVER_TOKEN=demo-approver-token
AUTH_PLANNER_TOKEN=demo-planner-token
AUTH_VIEWER_TOKEN=demo-viewer-token

# Optional: AI Copilot Provider (Read-Only Diagnostics)
# When omitted, rule-based diagnostic fallbacks are used automatically.
# GEMINI_API_KEY=your-api-key-here
